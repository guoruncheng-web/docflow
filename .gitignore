# Secrets. Real values live in each hosting provider's dashboard; the
# .env.example files document what has to be set.
.env
.env.*
!.env.example

# Anything that looks like a key file, wherever it lands.
*key*.md
*secret*
*.pem

# Dependencies and build output
node_modules/
dist/
build/
.next/
out/
*.tsbuildinfo

# Tooling
.vercel
.idea/
.vscode/
coverage/

# Noise
*.log
.DS_Store

# Dropped by the Neon integration CLI; not part of this project.
.agents/
.claude/
skills-lock.json

# Generated by `pnpm fixtures`; the repository keeps the script, not the PDFs.
server/fixtures/
