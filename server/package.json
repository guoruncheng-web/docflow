{
  "name": "docflow-api",
  "version": "1.0.0",
  "private": true,
  "description": "DocFlow API — document extraction, review and approval",
  "scripts": {
    "build": "node scripts/copy-swagger-assets.mjs && nest build && node scripts/stage-fixtures.mjs",
    "start": "nest start",
    "dev": "node scripts/copy-swagger-assets.mjs && nest start --watch",
    "start:prod": "node dist/src/main",
    "prisma:generate": "prisma generate",
    "prisma:deploy": "prisma migrate deploy",
    "fixtures": "tsx scripts/build-fixtures.ts",
    "comment:test": "pdf.js is ESM only, so the tests that read a PDF need Node's module support inside Jest's VM.",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --config test/jest.json",
    "vercel-build": "prisma generate && node scripts/copy-swagger-assets.mjs && nest build && node scripts/stage-fixtures.mjs"
  },
  "pnpm": {
    "comment": "pnpm blocks postinstall scripts by default. Prisma needs its to download the query engine, esbuild to unpack its platform binary.",
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  },
  "dependencies": {
    "@nestjs/common": "^11.0.12",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.12",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.12",
    "@nestjs/swagger": "^11.1.0",
    "@prisma/client": "^6.5.0",
    "@vercel/blob": "^2.8.0",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "4.10.38",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-dist": "5.32.8",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.5",
    "@nestjs/schematics": "^11.0.2",
    "@nestjs/testing": "^11.0.12",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.13.9",
    "@types/passport-jwt": "^4.0.1",
    "jest": "^29.7.0",
    "prisma": "^6.5.0",
    "ts-jest": "^29.2.6",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
